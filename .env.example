# Server
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Payment mode: "demo" confirms without card; "payfast" uses real/sandbox PayFast
PAYMENT_MODE=demo

# PayFast (required when PAYMENT_MODE=payfast)
# Sandbox: https://sandbox.payfast.co.za · Live: https://www.payfast.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Email (optional — if unset, messages are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sunday Bakery <orders@sundaybakery.co.za>"
BAKER_EMAIL=hello@sundaybakery.co.za
